{
  "common": {
    "name": "livecam",
    "version": "0.1.5",
    "news": {
      "0.1.5": {
        "en": "Camera wall reloads itself after an adapter restart (new cameras appear automatically); no permanent microphone hint",
        "de": "Die Kamerawand lädt sich nach einem Adapter-Neustart neu (neue Kameras erscheinen automatisch); kein dauerhafter Mikrofon-Hinweis mehr"
      },
      "0.1.4": {
        "en": "The IP column is only checked when it is used (ONVIF or path-only URL)",
        "de": "Die Spalte IP wird nur geprüft, wenn sie verwendet wird (ONVIF oder URL nur mit Pfad)"
      },
      "0.1.3": {
        "en": "Cameras in HTTPS-only mode: ONVIF over https (port 443 or automatic), redirects followed",
        "de": "Kameras im Modus „nur HTTPS“: ONVIF über https (Port 443 oder automatisch), Weiterleitungen werden befolgt"
      },
      "0.1.2": {
        "en": "The IP column may contain a port (e.g. 172.20.10.50:554)",
        "de": "In der Spalte IP darf ein Port stehen (z. B. 172.20.10.50:554)"
      },
      "0.1.1": {
        "en": "A path alone (e.g. /axis-media/media.amp) is completed with the IP address; clear errors for wrong IP addresses and URLs",
        "de": "Ein Pfad allein (z. B. /axis-media/media.amp) wird mit der IP-Adresse ergänzt; verständliche Fehler bei falscher IP-Adresse oder URL"
      },
      "0.1.0": {
        "en": "Initial release: live images for VIS-2, SIP door intercom with two-way audio and call history",
        "de": "Erste Version: Livebilder für VIS-2, SIP-Türsprechstelle mit Gegensprechen und Anrufliste"
      }
    },
    "titleLang": {
      "en": "Live camera images",
      "de": "Kamera-Livebilder"
    },
    "desc": {
      "en": "Robust MJPEG live images from RTSP, ONVIF and HTTP cameras for VIS-2, with automatic reconnect and SIP door intercom (2N) with two-way audio in the browser",
      "de": "Robuste MJPEG-Livebilder von RTSP-, ONVIF- und HTTP-Kameras für VIS-2, mit automatischem Neuverbinden und SIP-Türsprechstelle (2N) mit Gegensprechen im Browser"
    },
    "authors": [
      "andreaslampl"
    ],
    "license": "MIT",
    "platform": "Javascript/Node.js",
    "mode": "daemon",
    "icon": "livecam.png",
    "extIcon": "https://raw.githubusercontent.com/andreaslampl/ioBroker.livecam/main/admin/livecam.png",
    "readme": "https://github.com/andreaslampl/ioBroker.livecam/blob/main/README.md",
    "enabled": true,
    "type": "multimedia",
    "compact": true,
    "connectionType": "local",
    "dataSource": "poll",
    "adminUI": {
      "config": "json"
    },
    "tier": 2,
    "dependencies": [
      {
        "js-controller": ">=5.0.19"
      }
    ],
    "globalDependencies": [
      {
        "admin": ">=6.0.0"
      }
    ]
  },
  "native": {
    "port": 8095,
    "publicHost": "",
    "accessKey": "",
    "ffmpegPath": "ffmpeg",
    "cameras": [],
    "intercomEnabled": false,
    "sipPort": 5060,
    "intercomHost": "",
    "intercomCamera": "",
    "ringTimeout": 60,
    "doorMethod": "dtmf",
    "doorCode": "",
    "doorSwitch": 1,
    "intercomUser": "",
    "intercomPassword": "",
    "historySize": 20
  },
  "protectedNative": [
    "cameras",
    "accessKey",
    "intercomPassword",
    "doorCode"
  ],
  "objects": [],
  "instanceObjects": [
    {
      "_id": "info",
      "type": "channel",
      "common": {
        "name": "Information"
      },
      "native": {}
    },
    {
      "_id": "info.connection",
      "type": "state",
      "common": {
        "name": {
          "en": "Web server running",
          "de": "Webserver läuft"
        },
        "type": "boolean",
        "role": "indicator.connected",
        "read": true,
        "write": false,
        "def": false
      },
      "native": {}
    },
    {
      "_id": "cameras",
      "type": "folder",
      "common": {
        "name": {
          "en": "Cameras",
          "de": "Kameras"
        }
      },
      "native": {}
    },
    {
      "_id": "info.viewUrl",
      "type": "state",
      "common": {
        "name": {
          "en": "Camera wall URL (for VIS-2)",
          "de": "Kamerawand-URL (für VIS-2)"
        },
        "type": "string",
        "role": "url",
        "read": true,
        "write": false
      },
      "native": {}
    },
    {
      "_id": "intercom",
      "type": "channel",
      "common": {
        "name": {
          "en": "Intercom",
          "de": "Türsprechstelle"
        }
      },
      "native": {}
    },
    {
      "_id": "intercom.state",
      "type": "state",
      "common": {
        "name": {
          "en": "Call state",
          "de": "Anrufstatus"
        },
        "type": "string",
        "role": "text",
        "read": true,
        "write": false,
        "states": {
          "idle": "idle",
          "ringing": "ringing",
          "connecting": "connecting",
          "active": "active"
        }
      },
      "native": {}
    },
    {
      "_id": "intercom.ringing",
      "type": "state",
      "common": {
        "name": {
          "en": "Ringing",
          "de": "Es klingelt"
        },
        "type": "boolean",
        "role": "indicator",
        "read": true,
        "write": false
      },
      "native": {}
    },
    {
      "_id": "intercom.active",
      "type": "state",
      "common": {
        "name": {
          "en": "Call active",
          "de": "Gespräch läuft"
        },
        "type": "boolean",
        "role": "indicator",
        "read": true,
        "write": false
      },
      "native": {}
    },
    {
      "_id": "intercom.caller",
      "type": "state",
      "common": {
        "name": {
          "en": "Caller",
          "de": "Anrufer"
        },
        "type": "string",
        "role": "text",
        "read": true,
        "write": false
      },
      "native": {}
    },
    {
      "_id": "intercom.lastRing",
      "type": "state",
      "common": {
        "name": {
          "en": "Last ring",
          "de": "Zuletzt geklingelt"
        },
        "type": "string",
        "role": "date",
        "read": true,
        "write": false
      },
      "native": {}
    },
    {
      "_id": "intercom.openDoor",
      "type": "state",
      "common": {
        "name": {
          "en": "Open door",
          "de": "Tür öffnen"
        },
        "type": "boolean",
        "role": "button",
        "read": false,
        "write": true
      },
      "native": {}
    },
    {
      "_id": "intercom.hangup",
      "type": "state",
      "common": {
        "name": {
          "en": "Hang up / reject",
          "de": "Auflegen / ablehnen"
        },
        "type": "boolean",
        "role": "button",
        "read": false,
        "write": true
      },
      "native": {}
    },
    {
      "_id": "intercom.missedCount",
      "type": "state",
      "common": {
        "name": {
          "en": "Missed calls (unseen)",
          "de": "Verpasste Anrufe (ungesehen)"
        },
        "type": "number",
        "role": "value",
        "read": true,
        "write": false,
        "def": 0
      },
      "native": {}
    },
    {
      "_id": "intercom.lastMissed",
      "type": "state",
      "common": {
        "name": {
          "en": "Last missed call",
          "de": "Letzter verpasster Anruf"
        },
        "type": "string",
        "role": "date",
        "read": true,
        "write": false
      },
      "native": {}
    },
    {
      "_id": "intercom.history",
      "type": "state",
      "common": {
        "name": {
          "en": "Call history (JSON)",
          "de": "Anrufliste (JSON)"
        },
        "type": "string",
        "role": "json",
        "read": true,
        "write": false
      },
      "native": {}
    },
    {
      "_id": "intercom.missedSeen",
      "type": "state",
      "common": {
        "name": {
          "en": "Mark missed calls as seen",
          "de": "Verpasste Anrufe als gesehen markieren"
        },
        "type": "boolean",
        "role": "button",
        "read": false,
        "write": true
      },
      "native": {}
    }
  ],
  "encryptedNative": [
    "intercomPassword"
  ]
}
