{
  "i18n": true,
  "type": "tabs",
  "items": {
    "tabCameras": {
      "type": "panel",
      "label": "Cameras",
      "items": {
        "camHelp": {
          "type": "staticText",
          "text": "Type ONVIF: enter the IP address, the stream is found automatically. Type Stream: RTSP or HTTP-MJPEG URL. Type Snapshot: URL of a single JPEG image. Profile 0 = main stream, 1 = usually a lighter sub stream (recommended).",
          "xs": 12
        },
        "cameras": {
          "type": "table",
          "xs": 12,
          "newLine": true,
          "items": [
            {
              "type": "checkbox",
              "attr": "enabled",
              "title": "Active",
              "width": "5%",
              "default": true
            },
            {
              "type": "text",
              "attr": "name",
              "title": "Name",
              "width": "12%",
              "validator": "!!data.name",
              "default": ""
            },
            {
              "type": "select",
              "attr": "type",
              "title": "Type",
              "width": "10%",
              "default": "onvif",
              "options": [
                {
                  "label": "ONVIF",
                  "value": "onvif"
                },
                {
                  "label": "Stream (RTSP/HTTP)",
                  "value": "stream"
                },
                {
                  "label": "Snapshot (JPEG)",
                  "value": "snapshot"
                },
                {
                  "label": "VMS (Andreas L.-Arts)",
                  "value": "vms"
                }
              ]
            },
            {
              "type": "autocompleteSendTo",
              "attr": "vmsCamera",
              "title": "VMS camera",
              "width": "9%",
              "command": "vmsCameras",
              "default": "",
              "hidden": "data.type !== 'vms'"
            },
            {
              "type": "text",
              "attr": "host",
              "title": "IP (ONVIF)",
              "width": "10%",
              "default": ""
            },
            {
              "type": "number",
              "attr": "onvifPort",
              "title": "ONVIF port (80 http / 443 https)",
              "width": "6%",
              "default": 80
            },
            {
              "type": "number",
              "attr": "profile",
              "title": "Profile",
              "width": "5%",
              "default": 1,
              "min": 0
            },
            {
              "type": "text",
              "attr": "url",
              "title": "URL (Stream/Snapshot)",
              "width": "18%",
              "default": ""
            },
            {
              "type": "text",
              "attr": "user",
              "title": "User",
              "width": "8%",
              "default": ""
            },
            {
              "type": "password",
              "attr": "password",
              "title": "Password",
              "width": "8%",
              "default": ""
            },
            {
              "type": "number",
              "attr": "fps",
              "title": "FPS",
              "width": "5%",
              "default": 5,
              "min": 0.2,
              "max": 25
            },
            {
              "type": "number",
              "attr": "width",
              "title": "Width (px)",
              "width": "6%",
              "default": 1280,
              "min": 0
            },
            {
              "type": "checkbox",
              "attr": "keepAlive",
              "title": "Always on",
              "width": "5%",
              "default": false
            },
            {
              "type": "select",
              "attr": "detect",
              "title": "AI detection",
              "width": "9%",
              "default": "",
              "options": [
                {
                  "label": "off",
                  "value": ""
                },
                {
                  "label": "Persons",
                  "value": "person"
                },
                {
                  "label": "Persons + vehicles",
                  "value": "person,vehicle"
                },
                {
                  "label": "Persons + vehicles + animals",
                  "value": "person,vehicle,animal"
                },
                {
                  "label": "Vehicles",
                  "value": "vehicle"
                },
                {
                  "label": "Persons + animals",
                  "value": "person,animal"
                }
              ]
            },
            {
              "type": "checkbox",
              "attr": "plates",
              "title": "Plates",
              "width": "5%",
              "default": false
            },
            {
              "type": "checkbox",
              "attr": "faces",
              "title": "Faces",
              "width": "5%",
              "default": false
            }
          ]
        }
      }
    },
    "tabDetect": {
      "type": "panel",
      "label": "AI detection",
      "items": {
        "detectHelp": {
          "type": "staticText",
          "text": "Per camera in the camera table: column 'AI detection'. The model only runs when the picture changes (video cameras: key frames only), at most once per second and camera. Results: cameras.<name>.detect.* (person / vehicle / animal, counts, photo with boxes). Areas: page /zones of this adapter (link in info.zonesUrl).",
          "xs": 12
        },
        "detectScore": {
          "type": "number",
          "label": "Minimum certainty (%)",
          "default": 55,
          "min": 20,
          "max": 95,
          "help": "Lower = finds more, but more false alarms",
          "xs": 12,
          "sm": 6,
          "md": 3
        },
        "detectHold": {
          "type": "number",
          "label": "Stays on after the last detection (s)",
          "default": 20,
          "min": 2,
          "max": 3600,
          "help": "e.g. light on as long as somebody is there",
          "xs": 12,
          "sm": 6,
          "md": 3
        },
        "detectInterval": {
          "type": "number",
          "label": "At most one check per camera every (s)",
          "default": 1,
          "min": 0.3,
          "max": 30,
          "help": "Higher = less CPU",
          "xs": 12,
          "sm": 6,
          "md": 3
        },
        "plateHeader": {
          "type": "header",
          "text": "Number plates of own vehicles",
          "size": 4,
          "newLine": true
        },
        "plateHelp": {
          "type": "staticText",
          "text": "Tick 'Plates' in the camera table (the camera needs vehicle detection). While a vehicle is in the picture its plate is read a few times and compared with this list. Only plates on the list are reported by name; other plates are never stored or written to the log. Not suitable as the only key for gate or door - a plate can be copied.",
          "xs": 12
        },
        "plates": {
          "type": "table",
          "label": "Own plates",
          "xs": 12,
          "items": [
            {
              "type": "text",
              "attr": "plate",
              "title": "Plate (e.g. KL-482BX)",
              "width": "40%",
              "filter": false,
              "sort": false
            },
            {
              "type": "text",
              "attr": "name",
              "title": "Name (e.g. ID.4)",
              "width": "60%",
              "filter": false,
              "sort": false
            }
          ]
        },
        "plateUnknown": {
          "type": "checkbox",
          "label": "Report unknown vehicles",
          "help": "detect.plate = 'unbekannt' (without the plate text)",
          "default": false,
          "xs": 12,
          "sm": 6
        },
        "faceHeader": {
          "type": "header",
          "text": "Faces of the household",
          "size": 4,
          "newLine": true
        },
        "faceHelp": {
          "type": "staticText",
          "text": "Tick 'Faces' in the camera table (the camera needs person detection). Teach in the people on the page /faces of this adapter (photos or live at a camera) - it needs an access key (tab Web server). Only people on that page are recognised; other faces are never stored. Liveness detection catches photos and phones held in front of the camera, but not every screen: for opening a door combine it with something else (e.g. a button, a PIN, only by day).",
          "xs": 12
        },
        "faceMatch": {
          "type": "number",
          "label": "Minimum similarity (%)",
          "default": 45,
          "min": 30,
          "max": 90,
          "help": "higher = fewer mix-ups, but recognised less often",
          "xs": 12,
          "sm": 6,
          "md": 3
        },
        "faceMinSize": {
          "type": "number",
          "label": "Minimum face size (pixels)",
          "default": 50,
          "min": 30,
          "max": 400,
          "xs": 12,
          "sm": 6,
          "md": 3
        },
        "faceLive": {
          "type": "checkbox",
          "label": "Liveness detection",
          "default": true,
          "help": "needed for the door release",
          "newLine": true,
          "xs": 12,
          "sm": 6,
          "md": 3
        },
        "faceLiveMin": {
          "type": "number",
          "label": "Liveness at least (%)",
          "default": 80,
          "min": 30,
          "max": 99,
          "xs": 12,
          "sm": 6,
          "md": 3,
          "hidden": "!data.faceLive"
        },
        "faceUnknown": {
          "type": "checkbox",
          "label": "Report unknown faces",
          "help": "detect.face = 'unbekannt' (nothing is stored)",
          "default": false,
          "xs": 12,
          "sm": 6,
          "md": 3
        }
      }
    },
    "tabVms": {
      "type": "panel",
      "label": "VMS",
      "items": {
        "vmsHelp": {
          "type": "staticText",
          "text": "Optional: link to the Andreas L.-Arts VMS. Without an address nothing changes. Create the API key in the VMS under Settings -> Interface. Live pictures come through the VMS (RTSP if released there, else MJPEG), so every camera has only one connection - to the VMS.",
          "xs": 12
        },
        "vmsUrl": {
          "type": "text",
          "label": "VMS address",
          "help": "e.g. http://192.168.1.10:8080",
          "xs": 12,
          "sm": 6,
          "md": 4
        },
        "vmsKey": {
          "type": "password",
          "label": "API key (alvms_…)",
          "xs": 12,
          "sm": 6,
          "md": 4,
          "repeat": false,
          "visible": true
        },
        "vmsImport": {
          "type": "checkbox",
          "label": "Take over the cameras of the VMS",
          "help": "all VMS cameras appear in livecam without a row in the camera table",
          "newLine": true,
          "xs": 12,
          "sm": 6,
          "md": 4
        },
        "vmsFps": {
          "type": "number",
          "label": "Pictures per second (taken over cameras)",
          "min": 0.2,
          "max": 25,
          "default": 5,
          "xs": 12,
          "sm": 6,
          "md": 3,
          "hidden": "!data.vmsImport"
        },
        "vmsEvents": {
          "type": "checkbox",
          "label": "Events as data points",
          "help": "vms.cameras.<camera>.* (online, recording, person, car …, last event, plates, record mode, on/off)",
          "newLine": true,
          "xs": 12,
          "sm": 6,
          "md": 4
        },
        "vmsRing": {
          "type": "checkbox",
          "label": "Report ringing to the VMS",
          "help": "when the 2N rings: photo, recording and push in the VMS",
          "newLine": true,
          "xs": 12,
          "sm": 6,
          "md": 4
        },
        "vmsRingCamera": {
          "type": "autocompleteSendTo",
          "label": "VMS camera of the door",
          "command": "vmsCameras",
          "help": "empty = the VMS camera behind the intercom camera, else the one with the IP of the 2N",
          "xs": 12,
          "sm": 6,
          "md": 4,
          "hidden": "!data.vmsRing"
        },
        "vmsList": {
          "type": "staticText",
          "text": "The camera lists show the cameras of the VMS once address and key are saved.",
          "xs": 12
        }
      }
    },
    "tabServer": {
      "type": "panel",
      "label": "Web server",
      "items": {
        "port": {
          "type": "number",
          "label": "Port",
          "default": 8095,
          "min": 1,
          "max": 65535,
          "xs": 12,
          "sm": 6,
          "md": 3
        },
        "publicHost": {
          "type": "text",
          "label": "Address for the URLs (empty = automatic)",
          "help": "IP or host name of the ioBroker server as seen from the VIS-2 browser",
          "xs": 12,
          "sm": 6,
          "md": 4
        },
        "accessKey": {
          "type": "password",
          "label": "Access key (optional)",
          "help": "If set, URLs only work with ?key=… (it is added to the URLs automatically)",
          "newLine": true,
          "xs": 12,
          "sm": 6,
          "md": 4
        },
        "ffmpegPath": {
          "type": "text",
          "label": "ffmpeg path",
          "default": "ffmpeg",
          "help": "Install on the ioBroker server: sudo apt install ffmpeg",
          "xs": 12,
          "sm": 6,
          "md": 4
        }
      }
    },
    "tabIntercom": {
      "type": "panel",
      "label": "Intercom",
      "items": {
        "icHelp": {
          "type": "staticText",
          "text": "The intercom (e.g. 2N IP Verso) calls ioBroker directly (peer-to-peer SIP, no PBX). In the intercom enter as phone number: sip:door@<ioBroker IP>. In VIS-2 embed the camera wall (info.viewUrl) in an HTML widget.",
          "xs": 12
        },
        "intercomEnabled": {
          "type": "checkbox",
          "label": "Enable intercom",
          "newLine": true,
          "xs": 12
        },
        "intercomHost": {
          "type": "text",
          "label": "IP address of the intercom",
          "help": "Only this device may call (recommended)",
          "hidden": "!data.intercomEnabled",
          "newLine": true,
          "xs": 12,
          "sm": 6,
          "md": 3
        },
        "sipPort": {
          "type": "number",
          "label": "SIP port (UDP)",
          "default": 5060,
          "min": 1,
          "max": 65535,
          "hidden": "!data.intercomEnabled",
          "xs": 12,
          "sm": 6,
          "md": 2
        },
        "rtpPorts": {
          "type": "text",
          "label": "UDP ports for the sound",
          "help": "e.g. 40000-40019 (empty = random). Allow these UDP ports in the firewall: from the intercom and from the phones / touch PC to ioBroker",
          "hidden": "!data.intercomEnabled",
          "xs": 12,
          "sm": 6,
          "md": 3
        },
        "intercomCamera": {
          "type": "text",
          "label": "Camera name of the intercom",
          "help": "As entered in the camera table; shown full screen while ringing",
          "hidden": "!data.intercomEnabled",
          "xs": 12,
          "sm": 6,
          "md": 3
        },
        "ringTimeout": {
          "type": "number",
          "label": "Ring timeout (s)",
          "default": 60,
          "min": 10,
          "hidden": "!data.intercomEnabled",
          "xs": 12,
          "sm": 6,
          "md": 2
        },
        "doorMethod": {
          "type": "select",
          "label": "Open door via",
          "hidden": "!data.intercomEnabled",
          "newLine": true,
          "xs": 12,
          "sm": 6,
          "md": 3,
          "options": [
            {
              "label": "Key code during the call (DTMF)",
              "value": "dtmf"
            },
            {
              "label": "2N HTTP API",
              "value": "http"
            },
            {
              "label": "not used",
              "value": "none"
            }
          ]
        },
        "doorCode": {
          "type": "password",
          "label": "Door code (DTMF)",
          "help": "Switch code configured in the intercom, e.g. 00*",
          "hidden": "!data.intercomEnabled || data.doorMethod !== 'dtmf'",
          "xs": 12,
          "sm": 6,
          "md": 3
        },
        "doorSwitch": {
          "type": "number",
          "label": "Switch number",
          "default": 1,
          "min": 1,
          "max": 4,
          "hidden": "!data.intercomEnabled || data.doorMethod !== 'http'",
          "xs": 12,
          "sm": 6,
          "md": 2
        },
        "intercomUser": {
          "type": "text",
          "label": "HTTP API user",
          "hidden": "!data.intercomEnabled || data.doorMethod !== 'http'",
          "xs": 12,
          "sm": 6,
          "md": 3
        },
        "intercomPassword": {
          "type": "password",
          "label": "HTTP API password",
          "hidden": "!data.intercomEnabled || data.doorMethod !== 'http'",
          "xs": 12,
          "sm": 6,
          "md": 3
        },
        "stationsHeader": {
          "type": "header",
          "text": "Further door stations (e.g. Mobotix T25/T26)",
          "size": 5,
          "hidden": "!data.intercomEnabled",
          "newLine": true
        },
        "stationsHelp": {
          "type": "staticText",
          "text": "Each station calls sip:iobroker@<ioBroker-IP>:<SIP port> directly (peer to peer, no PBX). Camera: name from the camera table (empty = camera with the same IP). Door: DTMF code during the call, or a URL (GET, Basic/Digest login).",
          "hidden": "!data.intercomEnabled",
          "xs": 12
        },
        "intercoms": {
          "type": "table",
          "hidden": "!data.intercomEnabled",
          "xs": 12,
          "newLine": true,
          "items": [
            {
              "type": "checkbox",
              "attr": "enabled",
              "title": "Active",
              "width": "5%",
              "default": true
            },
            {
              "type": "text",
              "attr": "name",
              "title": "Name",
              "width": "12%",
              "default": ""
            },
            {
              "type": "text",
              "attr": "host",
              "title": "IP address",
              "width": "11%",
              "default": ""
            },
            {
              "type": "text",
              "attr": "camera",
              "title": "Camera name",
              "width": "11%",
              "default": ""
            },
            {
              "type": "select",
              "attr": "doorMethod",
              "title": "Door opener",
              "width": "10%",
              "default": "dtmf",
              "options": [
                {
                  "label": "Key code (DTMF)",
                  "value": "dtmf"
                },
                {
                  "label": "URL (HTTP)",
                  "value": "url"
                },
                {
                  "label": "none",
                  "value": "none"
                }
              ]
            },
            {
              "type": "text",
              "attr": "doorCode",
              "title": "Door code",
              "width": "8%",
              "default": ""
            },
            {
              "type": "text",
              "attr": "doorUrl",
              "title": "Door URL",
              "width": "23%",
              "default": ""
            },
            {
              "type": "text",
              "attr": "user",
              "title": "User",
              "width": "8%",
              "default": ""
            },
            {
              "type": "password",
              "attr": "password",
              "title": "Password",
              "width": "10%",
              "default": ""
            }
          ]
        },
        "historySize": {
          "type": "number",
          "label": "Calls in the history",
          "default": 20,
          "min": 1,
          "max": 200,
          "hidden": "!data.intercomEnabled",
          "newLine": true,
          "xs": 12,
          "sm": 6,
          "md": 3
        },
        "ringTone": {
          "type": "select",
          "label": "Ring tone",
          "default": "dingdong",
          "hidden": "!data.intercomEnabled",
          "newLine": true,
          "xs": 12,
          "sm": 6,
          "md": 3,
          "options": [
            {
              "label": "Ding-dong",
              "value": "dingdong"
            },
            {
              "label": "Westminster gong",
              "value": "gong"
            },
            {
              "label": "Chime",
              "value": "chime"
            },
            {
              "label": "Bell",
              "value": "bell"
            },
            {
              "label": "Telephone",
              "value": "phone"
            },
            {
              "label": "Westminster (full)",
              "value": "westminster"
            },
            {
              "label": "Für Elise",
              "value": "elise"
            },
            {
              "label": "Ode to Joy",
              "value": "ode"
            },
            {
              "label": "Frère Jacques",
              "value": "jakob"
            },
            {
              "label": "Alle meine Entchen",
              "value": "entchen"
            },
            {
              "label": "Cuckoo",
              "value": "kuckuck"
            },
            {
              "label": "Xylophone",
              "value": "xylophon"
            },
            {
              "label": "Harp",
              "value": "harfe"
            },
            {
              "label": "Triad",
              "value": "dreiklang"
            },
            {
              "label": "Own sound file (URL)",
              "value": "custom"
            }
          ]
        },
        "ringVolume": {
          "type": "slider",
          "label": "Ring tone volume (%)",
          "min": 0,
          "max": 100,
          "step": 5,
          "default": 70,
          "hidden": "!data.intercomEnabled",
          "xs": 12,
          "sm": 6,
          "md": 3
        },
        "ringToneUrl": {
          "type": "text",
          "label": "URL of the sound file (mp3/wav)",
          "help": "e.g. a file in ioBroker: http://<ioBroker-IP>:8082/vis-2.0/main/klingel.mp3",
          "hidden": "!data.intercomEnabled || data.ringTone !== 'custom'",
          "xs": 12,
          "sm": 12,
          "md": 6
        },
        "ringHelp": {
          "type": "staticText",
          "text": "Try it: open the camera wall with ?testring=1 (e.g. .../view?testring=1) and press 'Klingelton testen'.",
          "hidden": "!data.intercomEnabled",
          "newLine": true,
          "xs": 12
        }
      }
    }
  }
}
