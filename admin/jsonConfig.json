{
  "i18n": true,
  "type": "tabs",
  "items": {
    "tabCameras": {
      "type": "panel",
      "label": "Cameras",
      "items": {
        "camHelp": {
          "type": "staticText",
          "text": "Type ONVIF: enter the IP address, the stream is found automatically. Type Stream: RTSP or HTTP-MJPEG URL. Type Snapshot: URL of a single JPEG image. Profile 0 = main stream, 1 = usually a lighter sub stream (recommended).",
          "xs": 12
        },
        "cameras": {
          "type": "table",
          "xs": 12,
          "newLine": true,
          "items": [
            {
              "type": "checkbox",
              "attr": "enabled",
              "title": "Active",
              "width": "5%",
              "default": true
            },
            {
              "type": "text",
              "attr": "name",
              "title": "Name",
              "width": "12%",
              "validator": "!!data.name",
              "default": ""
            },
            {
              "type": "select",
              "attr": "type",
              "title": "Type",
              "width": "10%",
              "default": "onvif",
              "options": [
                {
                  "label": "ONVIF",
                  "value": "onvif"
                },
                {
                  "label": "Stream (RTSP/HTTP)",
                  "value": "stream"
                },
                {
                  "label": "Snapshot (JPEG)",
                  "value": "snapshot"
                }
              ]
            },
            {
              "type": "text",
              "attr": "host",
              "title": "IP (ONVIF)",
              "width": "10%",
              "default": ""
            },
            {
              "type": "number",
              "attr": "onvifPort",
              "title": "ONVIF port (80 http / 443 https)",
              "width": "6%",
              "default": 80
            },
            {
              "type": "number",
              "attr": "profile",
              "title": "Profile",
              "width": "5%",
              "default": 1,
              "min": 0
            },
            {
              "type": "text",
              "attr": "url",
              "title": "URL (Stream/Snapshot)",
              "width": "18%",
              "default": ""
            },
            {
              "type": "text",
              "attr": "user",
              "title": "User",
              "width": "8%",
              "default": ""
            },
            {
              "type": "password",
              "attr": "password",
              "title": "Password",
              "width": "8%",
              "default": ""
            },
            {
              "type": "number",
              "attr": "fps",
              "title": "FPS",
              "width": "5%",
              "default": 5,
              "min": 0.2,
              "max": 25
            },
            {
              "type": "number",
              "attr": "width",
              "title": "Width (px)",
              "width": "6%",
              "default": 1280,
              "min": 0
            },
            {
              "type": "checkbox",
              "attr": "keepAlive",
              "title": "Always on",
              "width": "5%",
              "default": false
            }
          ]
        }
      }
    },
    "tabServer": {
      "type": "panel",
      "label": "Web server",
      "items": {
        "port": {
          "type": "number",
          "label": "Port",
          "default": 8095,
          "min": 1,
          "max": 65535,
          "xs": 12,
          "sm": 6,
          "md": 3
        },
        "publicHost": {
          "type": "text",
          "label": "Address for the URLs (empty = automatic)",
          "help": "IP or host name of the ioBroker server as seen from the VIS-2 browser",
          "xs": 12,
          "sm": 6,
          "md": 4
        },
        "accessKey": {
          "type": "password",
          "label": "Access key (optional)",
          "help": "If set, URLs only work with ?key=… (it is added to the URLs automatically)",
          "newLine": true,
          "xs": 12,
          "sm": 6,
          "md": 4
        },
        "ffmpegPath": {
          "type": "text",
          "label": "ffmpeg path",
          "default": "ffmpeg",
          "help": "Install on the ioBroker server: sudo apt install ffmpeg",
          "xs": 12,
          "sm": 6,
          "md": 4
        }
      }
    },
    "tabIntercom": {
      "type": "panel",
      "label": "Intercom",
      "items": {
        "icHelp": {
          "type": "staticText",
          "text": "The intercom (e.g. 2N IP Verso) calls ioBroker directly (peer-to-peer SIP, no PBX). In the intercom enter as phone number: sip:door@<ioBroker IP>. In VIS-2 embed the camera wall (info.viewUrl) in an HTML widget.",
          "xs": 12
        },
        "intercomEnabled": {
          "type": "checkbox",
          "label": "Enable intercom",
          "newLine": true,
          "xs": 12
        },
        "intercomHost": {
          "type": "text",
          "label": "IP address of the intercom",
          "help": "Only this device may call (recommended)",
          "hidden": "!data.intercomEnabled",
          "newLine": true,
          "xs": 12,
          "sm": 6,
          "md": 3
        },
        "sipPort": {
          "type": "number",
          "label": "SIP port (UDP)",
          "default": 5060,
          "min": 1,
          "max": 65535,
          "hidden": "!data.intercomEnabled",
          "xs": 12,
          "sm": 6,
          "md": 2
        },
        "intercomCamera": {
          "type": "text",
          "label": "Camera name of the intercom",
          "help": "As entered in the camera table; shown full screen while ringing",
          "hidden": "!data.intercomEnabled",
          "xs": 12,
          "sm": 6,
          "md": 3
        },
        "ringTimeout": {
          "type": "number",
          "label": "Ring timeout (s)",
          "default": 60,
          "min": 10,
          "hidden": "!data.intercomEnabled",
          "xs": 12,
          "sm": 6,
          "md": 2
        },
        "doorMethod": {
          "type": "select",
          "label": "Open door via",
          "hidden": "!data.intercomEnabled",
          "newLine": true,
          "xs": 12,
          "sm": 6,
          "md": 3,
          "options": [
            {
              "label": "Key code during the call (DTMF)",
              "value": "dtmf"
            },
            {
              "label": "2N HTTP API",
              "value": "http"
            },
            {
              "label": "not used",
              "value": "none"
            }
          ]
        },
        "doorCode": {
          "type": "password",
          "label": "Door code (DTMF)",
          "help": "Switch code configured in the intercom, e.g. 00*",
          "hidden": "!data.intercomEnabled || data.doorMethod !== 'dtmf'",
          "xs": 12,
          "sm": 6,
          "md": 3
        },
        "doorSwitch": {
          "type": "number",
          "label": "Switch number",
          "default": 1,
          "min": 1,
          "max": 4,
          "hidden": "!data.intercomEnabled || data.doorMethod !== 'http'",
          "xs": 12,
          "sm": 6,
          "md": 2
        },
        "intercomUser": {
          "type": "text",
          "label": "HTTP API user",
          "hidden": "!data.intercomEnabled || data.doorMethod !== 'http'",
          "xs": 12,
          "sm": 6,
          "md": 3
        },
        "intercomPassword": {
          "type": "password",
          "label": "HTTP API password",
          "hidden": "!data.intercomEnabled || data.doorMethod !== 'http'",
          "xs": 12,
          "sm": 6,
          "md": 3
        },
        "historySize": {
          "type": "number",
          "label": "Calls in the history",
          "default": 20,
          "min": 1,
          "max": 200,
          "hidden": "!data.intercomEnabled",
          "newLine": true,
          "xs": 12,
          "sm": 6,
          "md": 3
        }
      }
    }
  }
}